/*
 * Copyright (c) 2023 Andrei Gaevskii
 *
 * Базовые слои — с ветки mriya58 (DEF / LWR / RSE / ADJ), без изменений.
 * Сверху добавлены GAME и GEXT: игровой режим без единого hold-tap.
 *   вход  — ADJ + W
 *   выход — крайний правый большой палец
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3
#define GAME 4
#define GEXT 5

&lt {
    quick_tap_ms = <200>;
};

&mt {
    quick_tap_ms = <200>;
    /* balanced: hold только если вторая клавиша ОТПУЩЕНА раньше пальца.
     * Дефолтный hold-preferred ловил Shift при перекрытии пробела с буквой. */
    flavor = "balanced";
};

/ {
    behaviors {
        /* Мод-тап для символов, которые набираются в быстром ролле (' \ ]).
         * tap-preferred + require-prior-idle: посреди набора всегда символ,
         * модификатор — только после паузы. */
        hts: hold_tap_symbol {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };
};

/* Sticky Super в GEXT: успеть отпустить слой и нажать цифру/букву в GAME */
&sk {
    release-after-ms = <2000>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp ESC  &kp N1    &kp N2     &kp N3           &kp N4     &kp N5       &kp N6          &kp N7     &kp N8                  &kp N9    &kp N0      &kp MINUS
&kp LWIN  &kp GRAVE   &kp Q     &kp W      &kp E            &kp R      &kp T        &kp Y           &kp U      &kp I                   &kp O     &kp P       &kp LBKT  &hts RWIN RBKT
          &kp LCTRL   &kp A     &kp S      &kp D            &kp F      &kp G        &kp H           &kp J      &kp K                   &kp L  &kp SEMI  &hts RCTRL SQT
           &kp LALT   &kp Z     &kp X      &kp C            &kp V      &kp B        &kp N           &kp M  &kp COMMA                 &kp DOT  &kp FSLH  &hts RALT BSLH
                             &kp LGUI  &lt 2 TAB  &mt LSHFT SPACE  &lt 1 RET    &lt 1 ESC  &mt RSHFT BSPC  &lt 2 DEL  &kp EQUAL
            >;
        };

        lower_layer {
            bindings = <
                &trans    &trans  &trans     &trans    &trans     &trans       &trans    &trans     &trans    &trans    &trans           &trans
&trans       &kp UNDER    &kp F1  &kp F2     &kp F3    &kp F4     &kp F5       &kp F6    &kp F7     &kp F8    &kp F9   &kp F10          &kp F11  &mt RGUI F12
        &mt LCTRL PLUS  &kp EXCL  &kp AT   &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR  &mt RCTRL MINUS
        &mt LALT EQUAL    &kp N1  &kp N2     &kp N3    &kp N4     &kp N5       &kp N6    &kp N7     &kp N8    &kp N9    &kp N0           &trans
                                  &trans  &lt 3 TAB    &trans     &trans       &trans    &trans  &lt 3 DEL    &trans
            >;
        };

        raise_layer {
            bindings = <
                 &trans           &trans     &trans     &trans     &trans        &trans          &trans    &trans     &trans     &trans           &trans           &trans
&trans       &kp KP_NUM     &kp KP_SLASH  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS    &kp C_VOL_UP  &kp HOME  &kp PSCRN  &kp PG_UP         &kp SLCK         &kp CAPS  &trans
        &mt LCTRL EQUAL  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_PLUS      &kp C_MUTE  &kp LEFT     &kp UP  &kp RIGHT          &kp INS  &mt RCTRL K_APP
                 &trans        &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3    &kp KP_DOT    &kp C_VOL_DN   &kp END   &kp DOWN  &kp PG_DN  &kp PAUSE_BREAK           &trans
                                             &trans     &trans     &trans     &lt 3 RET       &lt 3 ESC    &trans     &trans     &trans
            >;
        };

        /* ADJ + V — история буфера обмена: клавиша шлёт Super+Shift+V,
         * его ловит i3 (bindcode $mod+Shift+55) и дёргает `copyq toggle`.
         * Это HID-usage, а не символ, — работает и на RU-раскладке. */
        adjust_layer {
            bindings = <
             &none         &none         &none         &none         &none         &none           &none         &none         &none         &none         &none        &none
&none  &bootloader         &none     &tog GAME         &none         &none         &none           &none         &none         &none         &none         &none  &bootloader  &none
        &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0   &bt BT_CLR
        &sys_reset         &none         &none         &none &kp LG(LS(V))         &none           &none         &none         &none         &none         &none   &sys_reset
                                         &none        &trans         &none        &trans          &trans         &none        &trans         &none
            >;
        };

        /* ══════════════════════════════════════════════════════
         *  Layer 4 — GAME (вход: ADJ + W)
         *  Ни одного hold-tap: все клавиши — чистый &kp.
         *  Большие пальцы слева: ALT · CTRL · SHIFT · SPACE
         *  Мизинец домашнего ряда — LCTRL (присед), ESC только в цифровом ряду
         *  Выход: внешняя правая клавиша верхнего ряда (там, где ] в DEF).
         *  На крайнем правом большом пальце его больше НЕТ — он сидел под
         *  ладонью и ловил случайные нажатия посреди игры.
         * ══════════════════════════════════════════════════════ */
        game_layer {
            bindings = <
            &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS
&kp TAB    &kp GRAVE  &kp Q      &kp W      &kp E      &kp R      &kp T          &kp Y      &kp U      &kp I      &kp O      &kp P      &kp LBKT   &to DEF
           &kp LCTRL  &kp A      &kp S      &kp D      &kp F      &kp G          &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
           &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B          &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp BSLH
                                 &kp LALT   &kp LCTRL  &kp LSHFT  &kp SPACE      &kp RET    &mo GEXT   &kp BSPC   &none
            >;
        };

        /* ══════════════════════════════════════════════════════
         *  Layer 5 — GEXT (держать правым большим пальцем в GAME)
         *  F1–F12 верхним рядом · стрелки на HJKL · медиа
         *  Домашний ряд слева прозрачный: присед и ASDFG работают и с зажатым
         *  GEXT. Управление BT живёт только на ADJ — в игре оно било по бондам.
         *  Внешний левый верхний — sticky Super для i3 (тап, потом цифра в GAME)
         *  Выход в DEF: левый мизинец нижнего ряда или крайний палец
         * ══════════════════════════════════════════════════════ */
        game_ext_layer {
            bindings = <
            &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6         &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
&sk LGUI   &trans     &trans     &trans     &trans     &trans     &trans          &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp INS    &kp PSCRN  &trans
           &trans     &trans     &trans     &trans     &trans     &trans         &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp HOME   &kp END
           &to DEF    &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PP &kp PSCRN     &trans     &trans     &trans     &trans     &trans     &trans
                                 &trans     &trans     &trans     &trans          &trans     &trans     &trans     &to DEF
            >;
        };
    };
};
